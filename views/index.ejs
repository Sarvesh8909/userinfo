<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 p-16 text-white">

        <div class="nav text-blue-400 mb-10">
            <a href="/read">Read users</a>
        </div>
        
        <h1 class="text-3xl tracking-tighter mb-3">Create User</h1>

        <form action="/create" method="post" class="flex flex-col gap-4 w-96">
            <input class="px-5 py-2 border-2 border-zinc-800 outline-none bg-transparent" 
                type="text" name="name" placeholder="Name">

            <input class="px-5 py-2 border-2 border-zinc-800 outline-none bg-transparent" 
                type="email" name="email" placeholder="Email">

            <input class="px-5 py-2 border-2 border-zinc-800 outline-none bg-transparent" 
                type="text" name="image" placeholder="Image URL">

            <input class="px-5 py-3 bg-blue-500 rounded-lg cursor-pointer" 
                type="submit" value="Create User">
        </form>
    </div>
</body>
</html>
